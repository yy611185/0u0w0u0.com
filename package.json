{
  "name": "ouowouo-digital-garden",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "markdown-it": "^15.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.10.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.1.4",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  }
}
